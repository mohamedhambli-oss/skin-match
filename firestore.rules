rules_version = '2';

// Règles Firestore de SkinMatch — à déployer sur les DEUX projets :
//   firebase deploy --only firestore:rules --project skin-match-c7189
//   firebase deploy --only firestore:rules --project skin-match-pharmacie
// Principe : tout est refusé, sauf ce qui est explicitement autorisé ci-dessous.
// Tests : cd firestore-tests && npm test (émulateur Firestore).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Profil utilisateur : lisible et modifiable uniquement par son titulaire.
    // Liste fermée de champs : un client ne peut pas y stocker n'importe quoi.
    match /users/{uid} {
      function validUser() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'email', 'createdAt', 'updatedAt',
                                 'skinProfile', 'lastRoutine', 'routineHistory',
                                 'consentVersion', 'consentAcceptedAt', 'cguAcceptedAt',
                                 'healthConsentAt', 'healthConsentVersion',
                                 'feedback', 'lastReview'])
          && (!('name' in d) || (d.name is string && d.name.size() <= 80))
          && (!('email' in d) || d.email == null || d.email == request.auth.token.email)
          && (!('routineHistory' in d) || (d.routineHistory is list && d.routineHistory.size() <= 10));
      }
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();
    }

    // Anciennes collections : le titulaire peut seulement les lire et les effacer
    // (utilisé par la suppression de compte).
    match /routines/{uid}  { allow get, delete: if isOwner(uid); }
    match /feedbacks/{uid} { allow get, delete: if isOwner(uid); }

    // Codes-barres proposés par les utilisateurs.
    match /community_eans/{ean} {
      allow get: if true;                       // recherche par code-barres
      allow list: if signedIn() && resource.data.addedBy == request.auth.uid;   // ses propres ajouts
      allow create: if signedIn()
        && ean.matches('^[0-9]{8,14}$')
        && request.resource.data.keys().hasOnly(['ean', 'nom', 'marque', 'addedBy', 'addedAt', 'validated'])
        && request.resource.data.ean == ean
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 120
        && request.resource.data.marque is string && request.resource.data.marque.size() <= 80
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt is string
        && request.resource.data.validated == false;
      allow update: if false;                   // une fiche existante n'est jamais écrasée
      allow delete: if signedIn() && resource.data.addedBy == request.auth.uid
                    && resource.data.validated == false;
    }

    // Quotas du proxy IA : réservés au serveur (Admin SDK, qui ignore ces règles).
    match /ai_usage/{uid} { allow read, write: if false; }

    // Tout le reste est refusé.
    match /{document=**} { allow read, write: if false; }
  }
}
