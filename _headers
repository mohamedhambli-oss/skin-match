# En-têtes HTTP servis par Netlify (équivalent : section "headers" de firebase.json).
# Les protections ci-dessous n'ont aucun effet dans une balise <meta> : elles doivent
# être envoyées par l'hébergeur. La politique de contenu complète reste dans la page
# (<meta http-equiv="Content-Security-Policy">) ; les deux s'appliquent ensemble.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/*.html
  Cache-Control: no-cache

/data/products.js
  Cache-Control: no-cache

/data/catalogue.json
  Cache-Control: no-cache

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
